@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>> {
    Class I #FFFFFF
    Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
    Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
    Class "<<interface>>\nModel" as Model
    Class AddressBook
    Class ModelManager
    Class UserPrefs
    Class UniqueStudentList
    Class Student

    together {
        Class Name
        Class MatriculationNumber
        Class Phone
        Class Email
        Class Tag
        Class StudioGroup
    }

    together {
        Class RegisteredStudioRecords
        Class RegisteredMasteryChecks
        Class RegisteredNotes
        Class MissionSubmissions
    }

    Class StudioRecord
    Class MasteryCheck
    Class Note
    Class MissionCatalogue
    Class Mission
    Class MissionId
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook
ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .right.> ReadOnlyAddressBook
ModelManager -right-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

Student -[hidden]up--> I
UniqueStudentList -[hidden]right-> I

AddressBook *--> "1" UniqueStudentList
AddressBook *--> "1" MissionCatalogue
UniqueStudentList --> "~* all" Student
ModelManager --> "~* filtered" Student
MissionCatalogue *--> "*" Mission
Mission *-down-> "1" MissionId

Student *--> "1" Name
Student *--> "1" MatriculationNumber
Student *--> "1" Phone
Student *--> "1" Email
Student --> "*" Tag
Student *--> "1" StudioGroup
Student *--> "1" RegisteredStudioRecords
Student *--> "1" MissionSubmissions
Student *--> "1" RegisteredMasteryChecks
Student *--> "1" RegisteredNotes

RegisteredMasteryChecks *-down-> "*" MasteryCheck
MissionSubmissions -down-> "*" MissionId
RegisteredStudioRecords *--> "0..14" StudioRecord
RegisteredNotes *-down-> "0..1000" Note

' Preserve the upper section's relative arrangement.
Model -[hidden]right-> ReadOnlyAddressBook
ReadOnlyAddressBook -[hidden]right-> ReadOnlyUserPrefs
ModelManager -[hidden]right-> AddressBook
AddressBook -[hidden]right-> UserPrefs
UniqueStudentList -[hidden]right-> MissionCatalogue
Mission -[hidden]down-> Student

' Stack basic student fields vertically.
Name -[hidden]down-> MatriculationNumber
MatriculationNumber -[hidden]down-> Phone
Phone -[hidden]down-> Email
Email -[hidden]down-> Tag
Tag -[hidden]down-> StudioGroup

' Stack activity containers vertically.
RegisteredStudioRecords -[hidden]down-> RegisteredMasteryChecks
RegisteredMasteryChecks -[hidden]down-> RegisteredNotes
RegisteredNotes -[hidden]down-> MissionSubmissions

' Keep the two columns alongside each other.
Name -[hidden]right-> RegisteredStudioRecords

@enduml