@startuml
!include style.puml
skinparam linetype polyline
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>> {
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class UserPrefs
Class UniqueStudentList
Class Student
Class Name
Class Phone
Class Email
Class Tag
Class StudioGroup
Class RegisteredStudioRecords
Class StudioRecord
Class RegisteredMasteryChecks
Class MasteryCheck

Class MissionSubmissions
Class MissionCatalogue
Class Mission
Class MissionId
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook
ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniqueStudentList
AddressBook *--> "1" MissionCatalogue
UniqueStudentList --> "*" Student : all
ModelManager --> "*" Student : filtered
MissionCatalogue --> "*" Mission
Mission *--> "1" MissionId
Student *--> "1" Name
Student *--> "1" Phone
Student *--> "1" Email
Student --> "*" Tag
Student *--> "1" StudioGroup
Student *--> "1" RegisteredStudioRecords
Student *--> "1" MissionSubmissions
Student *--> "1" RegisteredMasteryChecks
RegisteredMasteryChecks *-down-> "*" MasteryCheck : assessment\nsessions
MissionSubmissions -down-> "*" MissionId : submitted IDs

Name -[hidden]right-> Phone
Phone -[hidden]right-> Email
Email -[hidden]right-> Tag
Tag -[hidden]right-> StudioGroup
StudioGroup -[hidden]right-> RegisteredStudioRecords
RegisteredStudioRecords -[hidden]right-> RegisteredMasteryChecks
MissionSubmissions -[hidden]right-> Name

'Keep the architecture and student values in the reference diagram's order.
ReadOnlyAddressBook -[hidden]right-> Model
Model -[hidden]right-> ReadOnlyUserPrefs
AddressBook -[hidden]right-> ModelManager
ModelManager -[hidden]right-> UserPrefs
MissionCatalogue -[hidden]right-> UniqueStudentList
RegisteredStudioRecords *--> "*" StudioRecord : records by week
Mission -[hidden]right-> MissionSubmissions
'Keep each record type below its owning container without crossing relationships.
MissionId -[hidden]right-> StudioRecord
StudioRecord -[hidden]right-> MasteryCheck
@enduml
