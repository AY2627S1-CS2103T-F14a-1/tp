@startuml
!include style.puml
skinparam linetype polyline
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

AddressBook *-right-> "1" UniqueStudentList
AddressBook *-right-> "1" UniqueTagList
UniqueTagList -[hidden]down- UniqueStudentList

UniqueTagList -right-> "*" Tag
UniqueStudentList -right-> "*" Student

Student -up-> "*" Tag

Student *--> "1" Name
Student *--> "1" Phone
Student *--> "1" Email
Student *--> "1" StudioGroup
Student *--> "1" RegisteredStudioRecords
RegisteredStudioRecords *--> "*" StudioRecord : records by week
Student *--> "1" MissionSubmissions
Student *--> "1" RegisteredMasteryChecks
RegisteredMasteryChecks *-down-> "*" MasteryCheck : assessment\nsessions

Name -[hidden]right-> Phone
Phone -[hidden]right-> Email
Email -[hidden]right-> StudioGroup
StudioGroup -[hidden]right-> RegisteredStudioRecords
RegisteredStudioRecords -[hidden]right-> RegisteredMasteryChecks
MissionSubmissions -[hidden]right-> Name
StudioRecord -[hidden]right-> MasteryCheck
@enduml
