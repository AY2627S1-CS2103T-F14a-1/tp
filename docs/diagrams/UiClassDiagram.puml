@startuml
!include style.puml

top to bottom direction
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 90
skinparam padding 12
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>> {
    class "<<interface>>\nUi" as Ui
    class UiManager
    class MainWindow
    class "{abstract}\nUiPart" as UiPart

    together {
        class HelpWindow
        class StatusBarFooter
        class StudentListPanel
        class StudentDetailsPanel
        class ResultDisplay
        class CommandBox
    }

    class StudentCard

    UiManager .left.|> Ui
    UiManager -down-> MainWindow

    MainWindow *-down-> CommandBox
    MainWindow *-down-> ResultDisplay
    MainWindow *-down-> StudentListPanel
    MainWindow *-down-> StudentDetailsPanel
    MainWindow *-down-> StatusBarFooter
    MainWindow -down-> HelpWindow

    StudentListPanel -down-> StudentCard

    MainWindow -down-|> UiPart
    CommandBox -down-|> UiPart
    ResultDisplay -down-|> UiPart
    StudentListPanel -down-|> UiPart
    StudentDetailsPanel -down-|> UiPart
    StudentCard -down-|> UiPart
    StatusBarFooter -down-|> UiPart
    HelpWindow -down-|> UiPart
}

package Logic <<Rectangle>> {
    class HiddenLogic #FFFFFF
}

package Model <<Rectangle>> {
    class HiddenModel #FFFFFF
}

class HiddenOutside #FFFFFF
HiddenOutside .down.> Ui

UiManager -[norank]-> Logic
MainWindow -[norank]-> Logic
StudentCard -[dashed,norank]-> Model

' Layout constraints only.
MainWindow -[hidden]right-> Logic
Logic -[hidden]down-> Model
CommandBox -[hidden]down-> Model

@enduml
