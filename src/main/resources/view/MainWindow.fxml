<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.Scene?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.stage.Stage"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1"
         onCloseRequest="#handleExit">
  <icons>
    <Image url="@/images/address_book_32.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@LightTheme.css" />
        <URL value="@Extensions.css" />
      </stylesheets>

      <VBox>
        <MenuBar fx:id="menuBar" VBox.vgrow="NEVER">
          <Menu mnemonicParsing="false" text="File">
            <MenuItem mnemonicParsing="false"
                      onAction="#handleExit"
                      text="Exit"/>
          </Menu>

          <Menu mnemonicParsing="false" text="Help">
            <MenuItem fx:id="helpMenuItem"
                      mnemonicParsing="false"
                      onAction="#handleHelp"
                      text="Help"/>
          </Menu>
        </MenuBar>

        <VBox spacing="5"
              styleClass="app-header"
              VBox.vgrow="NEVER">

          <HBox alignment="BASELINE_LEFT"
                spacing="8">

            <Label text="AvengerHub"
                   styleClass="app-title"/>

            <Label text="CS1101S student manager"
                   styleClass="app-subtitle"/>
          </HBox>
        </VBox>

        <VBox spacing="5"
              styleClass="command-section"
              VBox.vgrow="NEVER">

          <HBox spacing="8"
                alignment="CENTER_LEFT">

            <Label text="Command entered:"
                   styleClass="command-label"/>

            <Label fx:id="lastCommandLabel"
                   styleClass="last-command-label"/>
          </HBox>

          <StackPane fx:id="commandBoxPlaceholder"
                     styleClass="pane-with-border"/>

          <StackPane fx:id="resultDisplayPlaceholder"
                     styleClass="pane-with-border"
                     VBox.vgrow="NEVER"/>
        </VBox>

        <SplitPane fx:id="mainSplitPane"
                   dividerPositions="0.24"
                   VBox.vgrow="ALWAYS">

          <VBox minWidth="180"
                prefWidth="240"
                maxWidth="320"
                styleClass="student-list-container">

            <StackPane fx:id="studentListPanelPlaceholder"
                       VBox.vgrow="ALWAYS"/>
          </VBox>

          <StackPane fx:id="studentDetailsPanelPlaceholder"
                     styleClass="student-details-container"/>
        </SplitPane>

        <StackPane fx:id="statusbarPlaceholder"
                   VBox.vgrow="NEVER"/>
      </VBox>
    </Scene>
  </scene>
</fx:root>
